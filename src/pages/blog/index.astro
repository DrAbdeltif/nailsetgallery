---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/nav/Navbar.astro';
import MobileNav from '../../components/nav/MobileNav.astro';
import Footer from '../../components/nav/Footer.astro';
import CategoryPills from '../../components/nav/CategoryPills.astro';
import GalleryGrid from '../../components/gallery/GalleryGrid.astro';
import Tag from '../../components/ui/Tag.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Extract featured post or fallback to latest post
const featuredPost = posts.find((p) => p.data.featured) ?? posts[0];
const remainingPosts = posts.filter((p) => p.id !== featuredPost.id);

const galleryItems = remainingPosts.map((post) => ({
  title: post.data.title,
  image: post.data.heroImage ?? '/images/og-default.jpg',
  imageAlt: post.data.heroImageAlt ?? post.data.title,
  href: `/blog/${post.id}/`,
  category: post.data.category,
  tags: post.data.tags,
}));

const featuredPubDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric', month: 'short', day: 'numeric'
}).format(featuredPost.data.pubDate);

const featuredReadTime = Math.max(1, Math.ceil((featuredPost.body?.split(' ').length ?? 500) / 200));
---

<BaseLayout
  title="Nail Art Articles & Manicure Trends 2026"
  description="Browse all nail set articles — colors, styles, seasonal trends, and DIY tutorials. Find your next manicure inspiration."
>
  <Navbar />

  <main id="main-content" class="container page-main">
    <div class="page-header reveal-fade">
      <p class="label label-rose">✦ Editorial Magazine</p>
      <h1 class="page-title">Nail Inspiration & Beauty Gallery</h1>
      <p class="page-subtitle lead">
        Explore {posts.length} curated master guides, seasonal color trends, and salon-grade tutorials.
      </p>
    </div>

    <!-- High-Impact Featured Hero Post -->
    {featuredPost && (
      <section class="featured-hero reveal-fade" aria-label="Featured Article">
        <a href={`/blog/${featuredPost.id}/`} class="featured-hero__image-link">
          <img
            src={featuredPost.data.heroImage ?? '/images/og-default.jpg'}
            alt={featuredPost.data.heroImageAlt ?? featuredPost.data.title}
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
            class="featured-hero__img"
          />
        </a>

        <div class="featured-hero__content">
          <div class="featured-hero__meta">
            <Tag label={featuredPost.data.category} variant="blush" size="md" href={`/${featuredPost.data.category}/`} />
            <span class="featured-hero__badge">✦ Featured Guide</span>
            <span class="featured-hero__readtime">{featuredReadTime} min read</span>
          </div>

          <h2 class="featured-hero__title">
            <a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a>
          </h2>

          <p class="featured-hero__desc">
            {featuredPost.data.description}
          </p>

          <div class="featured-hero__footer">
            <span class="featured-hero__author">By <strong>{featuredPost.data.author ?? 'Elena Rostova'}</strong> • {featuredPubDate}</span>
            <a href={`/blog/${featuredPost.id}/`} class="btn-read-more">
              Read Guide &rarr;
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Category Filter Pills -->
    <div class="filter-section">
      <CategoryPills />
    </div>

    <!-- Remaining Articles Grid -->
    <section class="grid-section">
      <h2 class="section-subtitle">Latest Articles</h2>
      <GalleryGrid items={galleryItems} columns={4} />
    </section>
  </main>

  <Footer />
  <MobileNav />
</BaseLayout>

<style>
  .container { max-width: 1320px; margin: 0 auto; padding: 0 var(--space-lg); }
  .page-main { padding-top: calc(var(--space-3xl) + 80px); padding-bottom: var(--space-3xl); }
  .page-header { display: flex; flex-direction: column; gap: var(--space-sm); margin-bottom: var(--space-xl); }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-5xl));
    font-weight: 300;
    font-style: italic;
    color: var(--color-text);
    line-height: var(--leading-tight);
  }
  .page-subtitle { color: var(--color-text-muted); }

  /* Featured Hero Card */
  .featured-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-2xl);
    box-shadow: var(--shadow-card);
    transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }

  .featured-hero:hover {
    box-shadow: var(--shadow-hover);
  }

  @media (min-width: 1024px) {
    .featured-hero {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      padding: var(--space-xl);
    }
  }

  .featured-hero__image-link {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    aspect-ratio: 16/9;
  }

  .featured-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .featured-hero__image-link:hover .featured-hero__img {
    transform: scale(1.04);
  }

  .featured-hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .featured-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .featured-hero__badge {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-rose);
    background: var(--color-blush-light);
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  .featured-hero__readtime {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .featured-hero__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 400;
    line-height: var(--leading-snug);
    margin: 0;
  }

  .featured-hero__title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .featured-hero__title a:hover {
    color: var(--color-rose);
  }

  .featured-hero__desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .featured-hero__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-soft);
    margin-top: var(--space-sm);
  }

  .featured-hero__author {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .btn-read-more {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-rose);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .btn-read-more:hover {
    transform: translateX(4px);
  }

  .filter-section {
    margin-bottom: var(--space-xl);
  }

  .section-subtitle {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-style: italic;
    margin-bottom: var(--space-lg);
    color: var(--color-text);
  }

  @media (max-width: 767px) {
    .page-main { padding-top: calc(54px + var(--space-lg)); padding-bottom: calc(var(--space-2xl) + 70px); }
    .container { padding: 0 var(--space-md); }
    .featured-hero { padding: var(--space-md); }
  }
</style>
