---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/nav/Navbar.astro';
import MobileNav from '../../components/nav/MobileNav.astro';
import Footer from '../../components/nav/Footer.astro';
import Tag from '../../components/ui/Tag.astro';
import ArticleNav from '../../components/blog/ArticleNav.astro';
import RelatedPosts from '../../components/blog/RelatedPosts.astro';
import NewsletterSubscribe from '../../components/ui/NewsletterSubscribe.astro';
import QuickAnswer from '../../components/content/QuickAnswer.astro';
import ShopTheLook from '../../components/ui/ShopTheLook.astro';
import PinterestSaveButton from '../../components/ui/PinterestSaveButton.astro';
import AdSenseUnit from '../../components/ui/AdSenseUnit.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import SocialShareBar from '../../components/blog/SocialShareBar.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return sortedPosts.map((post, index) => {
    const prev = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null;
    const next = index > 0 ? sortedPosts[index - 1] : null;

    return {
      params: { slug: post.id },
      props: {
        post,
        allPosts: sortedPosts,
        prevPost: prev ? {
          id: prev.id,
          title: prev.data.title,
          heroImage: prev.data.heroImage,
          category: prev.data.category,
        } : null,
        nextPost: next ? {
          id: next.id,
          title: next.data.title,
          heroImage: next.data.heroImage,
          category: next.data.category,
        } : null,
      },
    };
  });
}

const { post, allPosts, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);


const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  authorBio,
  reviewer,
  reviewerRole,
  lastReviewedDate,
  medicalDisclaimer,
  difficulty,
  timeEstimate,
  costEstimate,
  testingNotes,
  isPillar,
  pillarUrl,
  heroImage,
  heroImageAlt,
  category,
  tags,
} = post.data;

const formattedPubDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
}).format(pubDate);

const formattedUpdated = updatedDate
  ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(updatedDate)
  : null;

const formattedLastReviewed = lastReviewedDate
  ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(lastReviewedDate)
  : null;

// Estimate reading time — rough estimate based on description length
const readingTime = Math.max(1, Math.ceil((post.body?.split(' ').length ?? 500) / 200));

// Contextual Related Posts calculation
const candidatePosts = allPosts || (await getCollection('blog', ({ data }) => !data.draft));
const relatedPosts = candidatePosts
  .filter((p) => p.id !== post.id)
  .map((p) => {
    let score = 0;
    if (p.data.category === category) score += 3;
    const sharedTags = p.data.tags.filter((t) => tags.includes(t));
    score += sharedTags.length * 2;
    return { post: p, score };
  })
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map(({ post: p }) => ({
    id: p.id,
    title: p.data.title,
    description: p.data.description,
    heroImage: p.data.heroImage,
    heroImageAlt: p.data.heroImageAlt,
    category: p.data.category,
    pubDate: p.data.pubDate,
  }));

// Dynamic FAQ Schema extraction
const faqItems: { question: string; answer: string }[] = [];
if (post.body) {
  const faqMatch = post.body.match(/## Frequently Asked Questions[\s\S]*?(?=---|\n## |$)/i);
  if (faqMatch) {
    const faqSection = faqMatch[0];
    const qMatches = Array.from(faqSection.matchAll(/### ([^\n]+)\n+([\s\S]*?)(?=\n### |\n## |---|$)/g));
    for (const match of qMatches) {
      const qText = match[1].trim();
      const aText = match[2].trim().replace(/[\r\n]+/g, ' ');
      if (qText && aText) {
        faqItems.push({ question: qText, answer: aText });
      }
    }
  }
}

const faqSchema = faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
} : null;

// Dynamic HowTo Schema extraction for tutorials & guides
const isTutorial = category === 'tutorials' || tags.some((t) => t.includes('tutorial') || t.includes('guide') || t.includes('diy'));
const howToSteps: { name: string; text: string }[] = [];
if (isTutorial && post.body) {
  const stepMatches = Array.from(post.body.matchAll(/### (Step \d+:[^\n]+|\d+\.[^\n]+)\n+([\s\S]*?)(?=\n### |\n## |---|$)/gi));
  for (const match of stepMatches) {
    const stepName = match[1].trim();
    const stepText = match[2].trim().replace(/[\r\n]+/g, ' ');
    if (stepName && stepText) {
      howToSteps.push({ name: stepName, text: stepText });
    }
  }
}

const howToSchema = howToSteps.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": title,
  "description": description,
  "image": heroImage ? `https://nailsetgallery.com${heroImage}` : undefined,
  "step": howToSteps.map((step, idx) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "name": step.name,
    "text": step.text,
  })),
} : null;

const editorialNote = category === 'tutorials'
  ? "Editorial note: Product formulas, UV lamps, and cure times vary by manufacturer. Follow all product instructions, prevent uncured liquid gel from contacting skin to avoid sensitization, and discontinue use if heat spikes or irritation occur."
  : 'Editorial note: Trend forecasts, nail art designs, and shade selections are editorial recommendations. Adjust nail shape, length, and formula to your lifestyle and natural nail health.';
---

<BaseLayout
  title={title}
  description={description}
  ogImage={heroImage}
  ogType="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  author={author}
>
  <!-- FAQ & HowTo Rich Snippets -->
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  )}
  {howToSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)}></script>
  )}

  <!-- Progress bar is injected by BaseLayout for articles -->
  <Navbar />

  <main id="main-content">
    <!-- Article header -->
    <header class="article-header container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol role="list">
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/blog/">Blog</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>

      <!-- Category + date -->
      <div class="article-meta reveal-fade">
        <Tag label={category} variant="blush" size="md" href={`/${category}/`} />
        {isPillar && (
          <span class="badge-pillar" title="Comprehensive Master Guide">✦ Pillar Guide</span>
        )}
        <time datetime={pubDate.toISOString()} class="article-date">
          Published: {formattedPubDate}
        </time>
        <span class="article-read-time">{readingTime} min read</span>
      </div>

      <!-- Title -->
      <h1 class="article-title reveal-fade">{title}</h1>

      <!-- Author & Reviewer E-E-A-T Row -->
      <div class="article-author-row reveal-fade">
        <div class="article-author">
          <div class="article-author__avatar" aria-hidden="true">
            {author?.charAt(0) ?? 'N'}
          </div>
          <div>
            <p class="article-author__name">
              By <strong>{author ?? 'Elena Rostova'}</strong>
            </p>
            {formattedUpdated && (
              <p class="article-author__updated">
                Updated: <time datetime={updatedDate?.toISOString()}>{formattedUpdated}</time>
              </p>
            )}
          </div>
        </div>

        {reviewer && (
          <div class="article-reviewer">
            <div class="reviewer-badge-icon" aria-hidden="true">✓</div>
            <div>
              <p class="reviewer-title">
                Reviewed by <strong>{reviewer}</strong>
              </p>
              <p class="reviewer-sub">
                {reviewerRole ?? 'Licensed Aesthetician & Nail Educator'} {formattedLastReviewed && `• ${formattedLastReviewed}`}
              </p>
            </div>
          </div>
        )}
      </div>
    </header>

    <!-- Pillar / Spoke Hub Navigation Notice -->
    {pillarUrl && (
      <div class="container">
        <aside class="pillar-banner" aria-label="Pillar Guide Reference">
          <div class="pillar-banner__icon">🏛️</div>
          <div class="pillar-banner__text">
            <strong>Part of our Master Topic Series:</strong> This focused guide explores a specific technique. For the full comprehensive foundation, read our main pillar: <a href={pillarUrl}>Comprehensive Master Guide &rarr;</a>
          </div>
        </aside>
      </div>
    )}

    <!-- Practical Spec Bar (Difficulty, Time, Cost) -->
    {(difficulty || timeEstimate || costEstimate) && (
      <div class="container">
        <div class="specs-bar">
          {difficulty && (
            <div class="spec-item">
              <span class="spec-label">Skill Level</span>
              <span class="spec-val spec-badge">{difficulty}</span>
            </div>
          )}
          {timeEstimate && (
            <div class="spec-item">
              <span class="spec-label">Estimated Time</span>
              <span class="spec-val">⏱️ {timeEstimate}</span>
            </div>
          )}
          {costEstimate && (
            <div class="spec-item">
              <span class="spec-label">Estimated Cost</span>
              <span class="spec-val">🏷️ {costEstimate}</span>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- Hero image with Pinterest Save Button -->
    {heroImage && (
      <div class="article-hero-image container-wide reveal-fade" style="position: relative;">
        <img
          src={heroImage}
          alt={heroImageAlt ?? title}
          loading="eager"
          decoding="async"
          width="1600"
          height="700"
          class="article-hero-img"
        />
        <PinterestSaveButton
          url={`https://nailsetgallery.com/blog/${post.id}/`}
          media={heroImage}
          description={`${title}: ${description}`}
          variant="floating"
        />
      </div>
    )}

    <!-- GEO / AEO Quick Answer Summary Box -->
    <div class="container">
      <QuickAnswer
        answerText={description}
        takeaways={[
          { label: 'Category', value: category.charAt(0).toUpperCase() + category.slice(1) },
          { label: 'Estimated Read', value: `${readingTime} min` },
          { label: 'Reviewed', value: formattedLastReviewed ?? formattedUpdated ?? formattedPubDate },
        ]}
      />
    </div>

    <!-- Health / Medical Disclaimer Banner (if applicable) -->
    {medicalDisclaimer && (
      <div class="container">
        <aside class="medical-disclaimer" aria-label="Medical and Health Disclaimer">
          <div class="disclaimer-header">
            <span class="disclaimer-icon">⚠️</span>
            <strong>Health, Safety & Dermatological Notice</strong>
          </div>
          <p>
            The chemical, nail health, and DIY removal techniques described in this article are for informational and aesthetic education only. They do not constitute medical or dermatological advice. If you experience burning, redness, nail dystrophy, onycholysis, or suspect an allergic reaction to acrylates, discontinue product use immediately and consult a board-certified dermatologist. Learn more in our <a href="/disclaimer/">Editorial & Health Disclaimer</a>.
          </p>
        </aside>
      </div>
    )}

    <!-- Editorial Testing Notes (if applicable) -->
    {testingNotes && (
      <div class="container">
        <aside class="testing-notes-box" aria-label="Hands-On Testing Notes">
          <strong>🔬 Editorial Testing Notes & Lab Observations:</strong>
          <p>{testingNotes}</p>
        </aside>
      </div>
    )}

    <aside class="editorial-note container" aria-label="Editorial note">
      <strong>Good to know</strong>
      <p>{editorialNote}</p>
    </aside>

    <!-- Top Social Share Bar -->
    <div class="container margin-bottom-lg">
      <SocialShareBar
        url={`https://nailsetgallery.com/blog/${post.id}/`}
        title={title}
        description={description}
        media={heroImage}
      />
    </div>

    <!-- Article Body with 2-Column Layout Grid -->
    <div class="article-body container-wide">
      <div class="article-layout-grid">
        <!-- Main Column -->
        <main class="article-main-column">
          <!-- Mobile Inline Table of Contents -->
          <div class="mobile-toc-wrapper">
            <TableOfContents headings={headings} />
          </div>

          <article class="prose">
            <Content />
          </article>

          <!-- Bottom Social Share Bar -->
          <div class="margin-top-xl">
            <SocialShareBar
              url={`https://nailsetgallery.com/blog/${post.id}/`}
              title={title}
              description={description}
              media={heroImage}
            />
          </div>

          <!-- Author Bio Box -->
          <section class="author-bio-card" aria-label="Author Profile">
            <div class="author-bio-card__avatar">
              {author?.charAt(0) ?? 'E'}
            </div>
            <div class="author-bio-card__content">
              <h3>Written by {author ?? 'Elena Rostova'}</h3>
              <p class="author-bio-card__role">Editorial Director & Master Nail Artist at NailSet Gallery</p>
              <p class="author-bio-card__desc">
                {authorBio ?? 'Elena Rostova is a veteran nail designer and salon consultant with over 9 years of experience in structured manicures, Japanese nuance gel art, and nail plate rehabilitation. Her work focuses on precision cuticle care and safe, damage-free DIY methods.'}
              </p>
              <div class="author-bio-card__links">
                <a href="/about/">About Our Editorial Standards &rarr;</a>
                <a href="/disclaimer/">Health & Review Policy &rarr;</a>
              </div>
            </div>
          </section>

          <!-- AdSense In-Article Display Unit -->
          <AdSenseUnit format="auto" />
        </main>

        <!-- Sticky Sidebar (Desktop Table of Contents & Quick Actions) -->
        <aside class="article-sidebar-desktop" aria-label="Article Navigation Sidebar">
          <div class="sticky-sidebar-inner">
            <TableOfContents headings={headings} />
          </div>
        </aside>
      </div>
    </div>


    <!-- Tags -->
    {tags.length > 0 && (
      <div class="article-tags container">
        <p class="label">Tags:</p>
        <div class="article-tags__list">
          {tags.map((tag) => (
            <Tag label={tag} variant="default" size="md" href={`/tags/${tag}/`} />
          ))}
        </div>
      </div>
    )}

    <!-- Next / Previous Navigation -->
    <ArticleNav prevPost={prevPost} nextPost={nextPost} />

    <!-- Related Posts -->
    <RelatedPosts posts={relatedPosts} />

    <!-- Newsletter CTA -->
    <div class="container">
      <NewsletterSubscribe variant="banner" />
    </div>

    <!-- Back to gallery -->
    <div class="article-footer container">
      <a href="/blog/" class="btn-back">
        ← Back to Gallery
      </a>
    </div>
  </main>

  <script src="../../scripts/step-flow.ts"></script>


  <Footer />
  <MobileNav />
</BaseLayout>

<style>
  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .container-wide {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  /* Article header */
  .article-header {
    padding-top: calc(var(--space-3xl) + 80px);
    padding-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* Breadcrumb */
  .breadcrumb ol {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
    min-height: auto;
  }

  .breadcrumb a:hover { color: var(--color-rose); }

  .breadcrumb [aria-hidden] {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .breadcrumb [aria-current] {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 200px;
  }

  /* Meta row */
  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .article-date,
  .article-read-time {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Title */
  .article-title {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 300;
    font-style: italic;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  /* Author */
  .article-author {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .article-author__avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background-color: var(--color-rose);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    font-weight: 300;
    flex-shrink: 0;
  }

  .article-author__name {
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--color-text);
    max-width: none;
  }

  .article-author__updated {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    max-width: none;
  }

  /* Hero image */
  .article-hero-image {
    margin-bottom: var(--space-2xl);
  }

  .article-hero-img {
    width: 100%;
    border-radius: var(--radius-lg);
    aspect-ratio: 16/7;
    object-fit: cover;
    background-color: var(--color-bg-deep);
  }

  /* Article body */
  .article-body {
    padding-bottom: var(--space-2xl);
  }

  .editorial-note {
    margin-bottom: var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    border-left: 3px solid var(--color-rose);
    background: var(--color-bg-deep);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .editorial-note strong { color: var(--color-text); }
  .editorial-note p { margin-top: var(--space-xs); }

  /* Tags */
  .article-tags {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    padding-bottom: var(--space-xl);
    border-top: 1px solid var(--color-border-soft);
    padding-top: var(--space-xl);
  }

  .article-tags__list {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  /* Footer */
  .article-footer {
    padding-bottom: calc(var(--space-2xl) + 70px);
  }

  @media (min-width: 768px) {
    .article-footer { padding-bottom: var(--space-2xl); }
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    min-height: 48px;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .btn-back:hover { color: var(--color-rose); }

  /* Step Flow Component (Editorial DIY Tutorials & Guides) */
  :global(.step-flow-container) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    background-color: var(--color-bg-deep);
    border: 1px solid rgba(139, 26, 74, 0.14);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    margin: var(--space-lg) 0;
    box-shadow: 0 2px 10px rgba(139, 26, 74, 0.03);
  }

  :global(.step-flow-container.step-flow-vertical) {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-sm);
  }

  :global(.step-flow-card) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFFFFF;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-full);
    padding: 6px 14px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  :global(.step-flow-badge) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
    background-color: var(--color-rose);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    flex-shrink: 0;
  }

  :global(.step-flow-text) {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: 0.01em;
  }

  :global(.step-flow-arrow) {
    color: var(--color-rose);
    font-size: 14px;
    margin: 0 2px;
  }

  :global(.step-flow-arrow--down) {
    text-align: center;
    font-size: 16px;
    margin: 2px 0;
  }

  /* Pillar Badge */
  .badge-pillar {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: linear-gradient(135deg, rgba(139, 26, 74, 0.12), rgba(199, 125, 155, 0.18));
    color: var(--color-rose);
    border: 1px solid rgba(139, 26, 74, 0.25);
    border-radius: var(--radius-full);
    padding: 3px 10px;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* Author & Reviewer E-E-A-T Row */
  .article-author-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background: var(--color-bg-deep);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
  }

  .article-reviewer {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-left: var(--space-md);
    border-left: 1px solid var(--color-border-soft);
  }

  .reviewer-badge-icon {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background-color: #2E7D32;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .reviewer-title {
    font-size: var(--text-xs);
    color: var(--color-text);
    margin: 0;
  }

  .reviewer-sub {
    font-size: 11px;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Pillar Banner */
  .pillar-banner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    background: linear-gradient(135deg, rgba(139, 26, 74, 0.06), rgba(199, 125, 155, 0.08));
    border: 1px solid rgba(139, 26, 74, 0.2);
    border-radius: var(--radius-md);
