---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/nav/Navbar.astro';
import MobileNav from '../../components/nav/MobileNav.astro';
import Footer from '../../components/nav/Footer.astro';
import CategoryPills from '../../components/nav/CategoryPills.astro';
import GalleryGrid from '../../components/gallery/GalleryGrid.astro';
import EditorialHubIntro from '../../components/content/EditorialHubIntro.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && data.category === 'tutorials');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const galleryItems = posts.map((post) => ({
  title: post.data.title,
  image: post.data.heroImage ?? '/images/og-default.jpg',
  imageAlt: post.data.heroImageAlt ?? post.data.title,
  href: `/blog/${post.id}/`,
  category: post.data.category,
  tags: post.data.tags,
}));
---

<BaseLayout
  title="DIY Nail Tutorials & Step-by-Step Care"
  description="Step-by-step DIY nail tutorials, gel manicure care, press-on application techniques, and healthy nail routines."
>
  <Navbar />

  <main id="main-content" class="container page-main">
    <div class="page-header reveal-fade">
      <p class="label label-rose">✦ How-To & Care</p>
      <h1 class="page-title">Nail Tutorials & Care</h1>
      <p class="page-subtitle lead">
        Master at-home manicures, press-on longevity, cuticle care, and professional gel removal step by step.
      </p>
    </div>

    <EditorialHubIntro
      eyebrow="Safe nail care and DIY technique"
      heading="Choose a tutorial by goal, product system, and removal method"
      intro="At-home nail tutorials work best when preparation, curing, wear time, and removal are treated as one process. Start with the guide that matches your product system, then follow the safety and maintenance steps before adding length or embellishment."
      answer="For beginners, press-ons are typically the simplest temporary option; Gel-X and builder gel require correct prep, compatible products, and a suitable lamp; acrylics require monomer handling and professional-level removal care. Never peel cured product from the natural nail, and stop if you feel pain, burning, or irritation."
      links={[
        { label: 'DIY Gel-X guide', href: '/blog/beginner-guide-diy-gel-x-nails-at-home/' },
        { label: 'Safe gel removal', href: '/blog/safe-gel-nail-polish-removal-at-home-guide/' },
        { label: 'Natural nail care', href: '/blog/ultimate-beginners-guide-natural-nail-care/' },
      ]}
    />

    <CategoryPills activeCategory="tutorials" />

    <section aria-label="Tutorial articles">
      <h2 class="section-title text-display mb-lg">Step-by-Step Guides</h2>
      {galleryItems.length > 0 ? (
        <GalleryGrid items={galleryItems} columns={4} />
      ) : (
        <div class="empty-state">
          <p>More DIY tutorials coming soon!</p>
          <a href="/blog/" class="btn-outline">Browse All Articles</a>
        </div>
      )}
    </section>

    <!-- Comprehensive Tutorial Methodology & Safety Guide -->
    <section class="tutorial-editorial-guide reveal-fade" aria-label="DIY nail tutorial protocols and safety">
      <div class="section-divider"></div>
      <div class="editorial-content-box">
        <h2 class="editorial-heading text-display">Mastering At-Home Manicure Science: The Complete DIY Protocol</h2>
        <p class="editorial-lead">
          Salon-quality results at home are achieved through methodical preparation, chemical compatibility, and safe removal techniques. Whether applying beginner press-on nails or mastering complex Gel-X soft gel extensions, our clinical nail educator protocols ensure durable wear without damaging your natural keratin matrix.
        </p>

        <div class="editorial-grid">
          <div class="editorial-card">
            <h3>🧼 1. Dehydration & Surface Keratin Prep</h3>
            <p>
              Over 80% of premature nail lifting occurs due to residual surface oils and moisture. Gently push back the eponychium (cuticle skin), lightly etch the surface with a 180/240 grit buffer in one direction, and cleanse thoroughly with 99% isopropyl alcohol or specialized nail dehydrator.
            </p>
          </div>
          <div class="editorial-card">
            <h3>⚡ 2. Gel Polymerization & UV/LED Curing Safety</h3>
            <p>
              Always match your gel system to a lamp with adequate optical wattage and wavelength output (typically 365nm + 405nm). Prevent under-cured monomer from contacting living periungual skin to minimize the risk of developing irreversible acrylate contact allergies.
            </p>
          </div>
          <div class="editorial-card">
            <h3>📦 3. Press-On Longevity & Adhesive Tabs vs Glue</h3>
            <p>
              For 1–3 day wear (events, weekends), breathable adhesive tabs provide quick, damage-free removal. For 2–3 week extended wear, apply cyanoacrylate resin glue evenly across both the natural nail and the artificial tip, pressing firmly at a 45-degree angle to eliminate air pockets.
            </p>
          </div>
          <div class="editorial-card">
            <h3>💧 4. Damage-Free Acetone Soaking Protocols</h3>
            <p>
              Never peel, rip, or bite off lifting gel or acrylic. File down the shiny top coat barrier, wrap each fingertip in pure acetone-soaked cotton foil for 12–15 minutes, and gently slide off softened product using a smooth wooden cuticle pusher.
            </p>
          </div>
        </div>

        <!-- Tutorial FAQs -->
        <div class="category-faqs">
          <h3 class="faq-title text-display">Frequently Asked Questions: DIY Nail Care</h3>
          
          <div class="faq-item">
            <h4>Why do my DIY gel nails lift after only 2 or 3 days?</h4>
            <p>
              Common culprits include getting gel onto the cuticle or lateral skin folds (which breaks the seal as the nail grows), skipping thorough alcohol dehydration, or under-curing the gel base layer in an underpowered UV lamp.
            </p>
          </div>

          <div class="faq-item">
            <h4>How can I repair a broken or split natural nail at home?</h4>
            <p>
              Use the classic tea bag silk wrap method: cut a tiny piece of tea bag mesh, adhere it over the crack with brush-on nail glue, gently buff the surface flat, and seal with builder gel or a strengthening top coat.
            </p>
          </div>

          <div class="faq-item">
            <h4>What is the safest way to remove press-on nails without damaging natural nails?</h4>
            <p>
              Soak hands in a warm bowl of water mixed with gentle liquid soap and a few tablespoons of olive or argan oil for 10–15 minutes. The oil breaks down adhesive tabs and glue gently without stripping natural moisture.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MobileNav />
</BaseLayout>

<style>
  .container { max-width: 1320px; margin: 0 auto; padding: 0 var(--space-lg); }
  .page-main { padding-top: calc(var(--space-3xl) + 80px); padding-bottom: var(--space-3xl); }
  .page-header { display: flex; flex-direction: column; gap: var(--space-sm); margin-bottom: var(--space-xl); }
  .page-title { font-family: var(--font-display); font-size: var(--text-5xl); font-weight: 300; font-style: italic; color: var(--color-text); line-height: var(--leading-tight); }
  .page-subtitle { color: var(--color-text-muted); }
  .mb-lg { margin-bottom: var(--space-lg); }
  .section-divider { height: 1px; background-color: var(--color-border-soft); margin: var(--space-2xl) 0; }

  .empty-state { text-align: center; padding: var(--space-2xl) 0; color: var(--color-text-muted); display: flex; flex-direction: column; align-items: center; gap: var(--space-md); }
  .btn-outline { display: inline-flex; align-items: center; padding: 12px var(--space-lg); border: 1.5px solid var(--color-rose); color: var(--color-rose); border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: 500; text-transform: uppercase; text-decoration: none; min-height: 48px; }

  /* Editorial Guide & FAQs */
  .tutorial-editorial-guide { margin-top: var(--space-2xl); }
  .editorial-content-box { max-width: 960px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-xl); }
  .editorial-heading { font-family: var(--font-display); font-size: var(--text-3xl); font-style: italic; color: var(--color-text); line-height: 1.25; }
  .editorial-lead { font-size: var(--text-base); color: var(--color-text-muted); line-height: 1.7; }
  .editorial-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-lg); }
  .editorial-card { background: var(--color-bg-card); border: 1px solid var(--color-border-soft); border-radius: var(--radius-md); padding: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-xs); }
  .editorial-card h3 { font-family: var(--font-display); font-size: var(--text-xl); font-style: italic; color: var(--color-text); margin: 0; }
  .editorial-card p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.6; margin: 0; }
  .category-faqs { margin-top: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-md); }
  .faq-title { font-family: var(--font-display); font-size: var(--text-2xl); font-style: italic; color: var(--color-rose); }
  .faq-item { background: var(--color-bg-card); border: 1px solid var(--color-border-soft); border-radius: var(--radius-md); padding: var(--space-md) var(--space-lg); }
  .faq-item h4 { font-family: var(--font-body); font-size: var(--text-base); font-weight: 600; color: var(--color-text); margin: 0 0 6px 0; }
  .faq-item p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.6; margin: 0; }

  @media (max-width: 1024px) { .editorial-grid { grid-template-columns: 1fr; } }
  @media (max-width: 767px) {
    .page-main { padding-top: calc(54px + var(--space-lg)); padding-bottom: calc(var(--space-2xl) + 70px); }
    .container { padding: 0 var(--space-md); }
    .editorial-heading { font-size: var(--text-2xl); }
  }
</style>
