---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/nav/Navbar.astro';
import MobileNav from '../components/nav/MobileNav.astro';
import Footer from '../components/nav/Footer.astro';

---

<BaseLayout
  title="Terms of Service & User Agreement | NailSet Gallery"
  description="Terms of Service for NailSet Gallery — Guidelines for using our site content and gallery resources."
>
  <Navbar />

  <main id="main-content" class="container page-main">
    <div class="page-header reveal-fade">
      <p class="label label-rose">✦ Terms of Service</p>
      <h1 class="page-title">Terms & Conditions</h1>
      <p class="page-subtitle lead">
        Last updated: July 28, 2026
      </p>
    </div>

    <article class="prose reveal-fade">
      <h2>1. Agreement to Terms</h2>
      <p>
        By accessing or using <strong>NailSet Gallery</strong> (<code>nailsetgallery.com</code>), you agree to be bound by these Terms and Conditions and our Privacy Policy. If you do not agree, please do not use our website.
      </p>

      <h2>2. Intellectual Property Rights</h2>
      <p>
        Unless otherwise indicated, the website, design, logo, text, graphics, and articles are our proprietary property or licensed to us. Content provided on NailSet Gallery is for personal, non-commercial inspiration only.
      </p>

      <h2>3. User Conduct & Submissions</h2>
      <p>
        You agree not to reproduce, duplicate, copy, sell, or exploit any portion of the service without express written permission from us. When submitting nail art or imagery to NailSet Gallery:
      </p>
      <ul>
        <li>You confirm that you own or possess the necessary rights and permissions to distribute the media.</li>
        <li>You grant NailSet Gallery a non-exclusive, worldwide, royalty-free license to display your imagery across our gallery and promotional social channels with appropriate attribution.</li>
      </ul>

      <h2>4. Disclaimer of Medical / Beauty Advice</h2>
      <p>
        All content provided on NailSet Gallery, including nail care tips and DIY tutorials, is for informational and educational purposes only. It is not intended to replace professional medical or dermatological advice regarding skin, nail infections, or allergies.
      </p>

      <h2>5. Limitation of Liability</h2>
      <p>
        NailSet Gallery will not be liable for any indirect, incidental, consequential, or punitive damages arising out of your access to or use of the site.
      </p>

      <h2>6. Governing Law</h2>
      <p>
        These Terms shall be governed by and construed in accordance with the laws of the jurisdiction in which NailSet Gallery operates.
      </p>

      <h2>7. Contact Information</h2>
      <p>
        Questions regarding the Terms & Conditions should be sent to: <a href="mailto:legal@nailsetgallery.com">legal@nailsetgallery.com</a>.
      </p>
    </article>
  </main>

  <Footer />
  <MobileNav />
</BaseLayout>

<style>
  .container { max-width: 760px; margin: 0 auto; padding: 0 var(--space-lg); }
  .page-main { padding-top: calc(var(--space-3xl) + 80px); padding-bottom: var(--space-3xl); }
  .page-header { display: flex; flex-direction: column; gap: var(--space-sm); margin-bottom: var(--space-2xl); }
  .page-title { font-family: var(--font-display); font-size: var(--text-5xl); font-weight: 300; font-style: italic; color: var(--color-text); line-height: var(--leading-tight); }
  .page-subtitle { color: var(--color-text-muted); }

  @media (max-width: 767px) {
    .page-main { padding-top: var(--space-xl); padding-bottom: calc(var(--space-2xl) + 70px); }
    .container { padding: 0 var(--space-md); }
  }
</style>
