---
// Search Modal Component
// Accessible dialog, backdrop blur, keyboard ESC to close, client-side filtering

import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const searchIndex = posts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  tags: p.data.tags,
  href: `/blog/${p.id}/`,
}));
---

<button
  class="search-mobile-trigger"
  data-search-trigger
  aria-label="Open search gallery"
  aria-expanded="false"
  aria-controls="search-modal"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
  </svg>
  <span>Search</span>
</button>

<div
  id="search-modal"
  class="search-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Search articles"
  aria-hidden="true"
  inert
>
  <button class="search-modal__backdrop" id="search-backdrop" aria-label="Close search" tabindex="-1"></button>

  <div class="search-modal__dialog">
    <header class="search-modal__header">
      <div class="search-modal__input-wrap">
        <!-- Visually-hidden label: satisfies WCAG 2.2 SC 1.3.1 (Info and Relationships) -->
        <label for="search-input" class="sr-only">Search articles by color, style, or trend</label>
        <svg
          width="20" height="20" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.5"
          class="search-icon"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input
          type="search"
          id="search-input"
          class="search-modal__input"
          placeholder="Search colors, styles, trends, shapes..."
          autocomplete="off"
          aria-describedby="search-hint"
        />
      </div>
      <button class="search-modal__close" id="search-close" aria-label="Close search">
        Esc
      </button>
    </header>

    <div class="search-modal__results" id="search-results" role="region" aria-live="polite" aria-label="Search results">
      <p class="search-modal__hint" id="search-hint">Start typing to search...</p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ searchIndex }}>
  const triggers = Array.from(document.querySelectorAll('[data-search-trigger]'));
  const modal = document.getElementById('search-modal');
  const backdrop = document.getElementById('search-backdrop');
  const closeBtn = document.getElementById('search-close');
  const input = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');
  const focusableSelector = 'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';
  let activeTrigger = null;

  function setTriggerExpanded(expanded) {
    triggers.forEach((button) => button.setAttribute('aria-expanded', String(expanded)));
  }

  function openModal(trigger) {
    if (!modal) return;
    activeTrigger = trigger instanceof HTMLElement ? trigger : document.activeElement;
    modal.removeAttribute('inert');
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    setTriggerExpanded(true);
    document.body.style.overflow = 'hidden';
    setTimeout(() => input?.focus(), 100);
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    modal.setAttribute('inert', '');
    setTriggerExpanded(false);
    document.body.style.overflow = '';
    if (input) input.value = '';
    renderResults([]);
    activeTrigger?.focus?.();
    activeTrigger = null;
  }

  // Event delegation for search triggers (handles Navbar, MobileNav, and dynamically added triggers)
  document.addEventListener('click', (e) => {
    const trigger = e.target.closest?.('[data-search-trigger]');
    if (trigger) {
      e.preventDefault();
      openModal(trigger);
    }
  });

  backdrop?.addEventListener('click', closeModal);
  closeBtn?.addEventListener('click', closeModal);

  // Auto-open modal if URL contains ?search= query parameter (e.g. from Google SearchBox or WebMCP)
  function checkUrlSearchParam() {
    const params = new URLSearchParams(window.location.search);
    const query = params.get('search') || params.get('q');
    if (query && input) {
      openModal();
      input.value = query;
      input.dispatchEvent(new Event('input', { bubbles: true }));
    }
  }
  checkUrlSearchParam();
  document.addEventListener('astro:page-load', checkUrlSearchParam);

  window.addEventListener('keydown', (e) => {
    const isShortcut = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
    if (isShortcut) {
      e.preventDefault();
      openModal(document.activeElement);
      return;
    }

    if (e.key === 'Escape' && modal?.classList.contains('open')) {
      closeModal();
      return;
    }

    if (e.key === 'Tab' && modal?.classList.contains('open')) {
      trapFocus(e);
    }
  });

  input?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    if (query.length === 0) {
      renderResults([]);
      return;
    }

    const matches = searchIndex.filter((item) => {
      return (
        item.title.toLowerCase().includes(query) ||
        item.description.toLowerCase().includes(query) ||
        item.category.toLowerCase().includes(query) ||
        item.tags.some((t) => t.toLowerCase().includes(query))
      );
    });

    renderResults(matches);
  });

  function renderResults(matches) {
    if (!resultsContainer) return;
    resultsContainer.replaceChildren();

    if (input && input.value.trim().length === 0) {
      resultsContainer.append(createHint('Start typing to search...'));
      return;
    }

    if (matches.length === 0) {
      resultsContainer.append(createHint('No nail styles found matching your search.'));
      return;
    }

    const fragment = document.createDocumentFragment();

    matches.forEach((match) => {
      const link = document.createElement('a');
      link.href = match.href;
      link.className = 'search-result-item';

      const category = document.createElement('span');
      category.className = 'search-result-tag';
      category.textContent = match.category.toUpperCase();
      category.style.cssText = 'display:block;font-size:10px;text-transform:uppercase;letter-spacing:0.12em;color:var(--color-rose);font-weight:500;margin-bottom:4px;';

      const title = document.createElement('strong');
      title.className = 'search-result-title';
      title.textContent = match.title;
      title.style.cssText = 'display:block;font-size:1rem;line-height:1.35;font-weight:600;color:var(--color-text);margin-bottom:4px;';

      const description = document.createElement('p');
      description.className = 'search-result-desc';
      description.textContent = match.description;
      description.style.cssText = 'display:block;font-size:0.8125rem;line-height:1.45;color:var(--color-text-muted);margin:0;';

      link.append(category, title, description);
      fragment.append(link);
    });

    resultsContainer.append(fragment);
  }

  function createHint(text) {
    const hint = document.createElement('p');
    hint.className = 'search-modal__hint';
    hint.textContent = text;
    return hint;
  }

  function trapFocus(event) {
    if (!modal) return;
    const focusable = Array.from(modal.querySelectorAll(focusableSelector))
      .filter((element) => element instanceof HTMLElement && element.offsetParent !== null);
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  }
</script>

<style>
  .search-mobile-trigger {
    display: none;
  }

  .search-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-toast);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .search-modal.open {
    opacity: 1;
    pointer-events: auto;
  }

  .search-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(28, 28, 28, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 0;
    width: 100%;
    min-height: 100%;
  }

  .search-modal__dialog {
    position: relative;
    z-index: 1;
    width: 90%;
    max-width: 640px;
    background-color: var(--color-bg-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.15);
    overflow: hidden;
  }

  .search-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .search-modal__input-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex: 1;
  }

  .search-icon {
    color: var(--color-text-muted);
  }

  .search-modal__input {
    width: 100%;
    border: none;
    background: none;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--color-text);
    outline: none;
  }

  .search-modal__close {
    font-size: var(--text-xs);
    font-family: var(--font-body);
    color: var(--color-text-subtle);
    padding: 4px 8px;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-sm);
    background: var(--color-bg-deep);
  }

  .search-modal__results {
    max-height: min(520px, 56vh);
    overflow-y: auto;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .search-modal__hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
    padding: var(--space-lg) 0;
  }

  /* Search Result Item */
  :global(.search-result-item) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-md);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  :global(.search-result-item:hover) {
    background-color: var(--color-blush-light);
  }

  :global(.search-result-tag) {
    display: block;
    font-size: 10px;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-rose);
    font-weight: 500;
  }

  :global(.search-result-title) {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.35;
    font-weight: 600;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  :global(.search-result-desc) {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .search-mobile-trigger {
      display: none;
    }

    .search-modal {
      padding-top: var(--space-lg);
      align-items: flex-start;
    }

    .search-modal__dialog {
      width: calc(100% - var(--space-lg) * 2);
      max-height: calc(100svh - var(--space-xl));
    }

    .search-modal__header {
      padding: var(--space-sm) var(--space-md);
    }

    .search-modal__input {
      font-size: var(--text-base);
    }

    .search-modal__results {
      max-height: calc(100svh - 132px);
      padding: var(--space-sm);
      gap: 2px;
    }

    :global(.search-result-item) {
      padding: 14px var(--space-md);
      border-bottom: 1px solid var(--color-border-soft);
      border-radius: var(--radius-sm);
    }

    :global(.search-result-item:last-child) {
      border-bottom: 0;
    }

    :global(.search-result-title) {
      margin-top: 5px;
      font-size: 0.9375rem;
      line-height: 1.3;
      max-height: 2.6em;
    }

    :global(.search-result-desc) {
      margin-top: 3px;
      font-size: 0.75rem;
      line-height: 1.4;
      max-height: 1.4em;
    }
  }
</style>
