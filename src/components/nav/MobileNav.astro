---
// Mobile bottom tab bar — visible only on screens < 768px
// 5-tab layout: Home, Gallery, Trends, Tutorials, Search
// Quiz & About are accessible via the top hamburger drawer (Navbar.astro)

const currentPath = Astro.url.pathname;

const tabs = [
  {
    href: '/',
    label: 'Home',
    icon: `<path d="M3 9.5L12 3l9 6.5V20a1 1 0 01-1 1H4a1 1 0 01-1-1V9.5z"/><polyline points="9,21 9,12 15,12 15,21"/>`,
    exact: true,
    type: 'link',
  },
  {
    href: '/blog/',
    label: 'Gallery',
    icon: `<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>`,
    exact: false,
    type: 'link',
  },
  {
    href: '/trends/',
    label: 'Trends',
    icon: `<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>`,
    exact: false,
    type: 'link',
  },
  {
    href: '/tutorials/',
    label: 'Tutorials',
    icon: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>`,
    exact: false,
    type: 'link',
  },
  {
    href: null,
    label: 'Search',
    icon: `<circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>`,
    exact: false,
    type: 'search',
  },
] as const;

function isActive(tab: typeof tabs[number]) {
  if (tab.type === 'search') return false;
  if (tab.exact) return currentPath === '/' || currentPath === '';
  return tab.href ? currentPath.startsWith(tab.href) : false;
}
---

<nav
  class="mobile-nav"
  aria-label="Mobile Navigation"
  role="navigation"
>
  {tabs.map((tab) => {
    const active = isActive(tab);
    if (tab.type === 'search') {
      return (
        <button
          class="mobile-nav__tab mobile-nav__search-trigger"
          data-search-trigger
          aria-label="Open search"
          type="button"
        >
          <span class="mobile-nav__icon-wrapper">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={tab.icon}
            />
          </span>
          <span class="mobile-nav__label">{tab.label}</span>
        </button>
      );
    }
    return (
      <a
        href={tab.href}
        class={`mobile-nav__tab ${active ? 'mobile-nav__tab--active' : ''}`}
        aria-label={tab.label}
        aria-current={active ? 'page' : undefined}
      >
        <span class="mobile-nav__icon-wrapper">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width={active ? '2' : '1.5'}
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={tab.icon}
          />
        </span>
        <span class="mobile-nav__label">{tab.label}</span>
      </a>
    );
  })}
</nav>

<script>
  // Mobile nav auto-hide on scroll down, reveal on scroll up
  const mobileNav = document.querySelector('.mobile-nav');
  let lastScrollY = typeof window !== 'undefined' ? window.scrollY : 0;
  const delta = 8;

  function updateMobileNav() {
    if (!mobileNav) return;
    const currentScrollY = window.scrollY;

    if (currentScrollY <= 60) {
      mobileNav.classList.remove('mobile-nav--hidden');
    } else if (currentScrollY > lastScrollY + delta) {
      mobileNav.classList.add('mobile-nav--hidden');
    } else if (currentScrollY < lastScrollY - delta) {
      mobileNav.classList.remove('mobile-nav--hidden');
    }

    lastScrollY = Math.max(0, currentScrollY);
  }

  updateMobileNav();

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateMobileNav();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });
</script>

<style>
  .mobile-nav {
    display: none; /* hidden on desktop */
  }

  @media (max-width: 767px) {
    .mobile-nav {
      display: flex;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: var(--z-nav);
      background-color: var(--color-surface-blur);
      backdrop-filter: blur(16px) saturate(1.6);
      -webkit-backdrop-filter: blur(16px) saturate(1.6);
      border-top: 1px solid var(--color-border-soft);
      /* iOS home indicator safe area */
      padding-bottom: env(safe-area-inset-bottom, 8px);
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.04);
      transition: transform var(--duration-normal) var(--ease-out);
    }

    .mobile-nav.mobile-nav--hidden {
      transform: translateY(100%);
    }

    .mobile-nav__tab {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      padding: 8px 4px;
      min-height: 60px;
      min-width: 0;
      color: var(--color-text-subtle);
      text-decoration: none;
      background: none;
      border: none;
      font: inherit;
      cursor: pointer;
      transition: color var(--duration-fast) var(--ease-out);
      -webkit-tap-highlight-color: transparent;
      position: relative;
    }

    .mobile-nav__tab--active {
      color: var(--color-rose);
    }

    .mobile-nav__tab--active::before {
      content: '';
      position: absolute;
      top: 0;
      left: 25%;
      right: 25%;
      height: 2px;
      background-color: var(--color-rose);
      border-radius: var(--radius-full);
    }

    .mobile-nav__search-trigger {
      color: var(--color-text-subtle);
    }

    .mobile-nav__search-trigger:active,
    .mobile-nav__tab:active {
      opacity: 0.75;
    }

    .mobile-nav__icon-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
    }

    .mobile-nav__label {
      font-family: var(--font-body);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.02em;
      line-height: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }
  }
</style>
