---
// Glassmorphism floating luxury desktop & mobile navbar
// High-level site navigation: Gallery, Trends, Tutorials, Quiz, About + Search trigger & Mobile Drawer
// Integrates high-craft luxury editorial design with 60fps scroll experience & progress bar

const navLinks = [
  { href: '/blog/', label: 'Gallery' },
  { href: '/trends/', label: 'Trends' },
  { href: '/tutorials/', label: 'Tutorials' },
  { href: '/quiz/', label: 'Quiz ✦' },
  { href: '/about/', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header class="navbar" id="navbar" role="banner">
  <!-- Scroll Progress Bar embedded at navbar bottom edge -->
  <div class="navbar__progress-track" aria-hidden="true">
    <div class="navbar__progress-bar" id="navbar-progress-bar"></div>
  </div>

  <nav
    class="navbar__inner"
    aria-label="Main Navigation"
  >
    <!-- Logo -->
    <a href="/" class="navbar__logo" aria-label="NailSet Gallery — Home">
      <span class="navbar__logo-sparkle" aria-hidden="true">✦</span>
      <span class="navbar__logo-text">NSG</span>
      <span class="navbar__logo-divider" aria-hidden="true">/</span>
      <span class="navbar__logo-full">NailSet Gallery</span>
    </a>

    <!-- Desktop Nav Links -->
    <ul class="navbar__links" role="list">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <li>
            <a
              href={link.href}
              class={`nav-link navbar__link ${isActive ? 'navbar__link--active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              <span class="navbar__link-text">{link.label}</span>
              {isActive && <span class="navbar__active-indicator" aria-hidden="true"></span>}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Actions Right Group -->
    <div class="navbar__actions">
      <!-- Search Trigger Pill -->
      <button
        class="navbar__search-btn"
        id="search-trigger"
        data-search-trigger
        aria-label="Open search gallery"
        aria-expanded="false"
        aria-controls="search-modal"
      >
        <svg class="navbar__search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <span class="navbar__search-label">Search...</span>
        <kbd class="navbar__search-kbd" aria-hidden="true">⌘K</kbd>
      </button>

      <!-- Mobile Hamburger Toggle -->
      <button
        class="navbar__mobile-toggle"
        id="mobile-menu-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <span class="hamburger-box">
          <span class="hamburger-inner"></span>
        </span>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer Dropdown Panel -->
  <div
    class="mobile-drawer"
    id="mobile-menu-drawer"
    aria-hidden="true"
    inert
  >
    <div class="mobile-drawer__content">
      <ul class="mobile-drawer__links" role="list">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <li>
              <a
                href={link.href}
                class={`mobile-drawer__link ${isActive ? 'mobile-drawer__link--active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                <span>{link.label}</span>
                {isActive && <span class="mobile-drawer__active-dot"></span>}
              </a>
            </li>
          );
        })}
      </ul>

      <div class="mobile-drawer__footer">
        <button
          class="mobile-drawer__search-btn"
          data-search-trigger
          aria-label="Open search gallery"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
          <span>Search Gallery</span>
        </button>
        <div class="mobile-drawer__badge">
          ✦ Velvet Bloom Collection 2026
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // ── Navbar Scroll Experience Engine ──
  // Features:
  // 1. Smooth scroll-driven morphing (compact padding, refined glass blur, subtle elevation)
  // 2. High-performance scroll progress line (transform scaleX via RAF)
  // 3. Directional smart sticky reveal on scroll-up / auto-hide on scroll-down
  // 4. Accessible mobile navigation drawer logic with keyboard ESC trap

  const navbar = document.getElementById('navbar');
  const progressBar = document.getElementById('navbar-progress-bar');
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileDrawer = document.getElementById('mobile-menu-drawer');
  const mobileLinks = document.querySelectorAll('.mobile-drawer__link');

  let lastScrollY = typeof window !== 'undefined' ? window.scrollY : 0;
  const delta = 6;
  let isMobileMenuOpen = false;

  // 1. Update Scroll State & Progress Bar
  function updateScrollState() {
    const currentScrollY = window.scrollY;
    const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;

    // Update Progress Bar
    if (progressBar && scrollHeight > 0) {
      const progress = Math.min(Math.max(currentScrollY / scrollHeight, 0), 1);
      progressBar.style.transform = `scaleX(${progress})`;
    }

    if (!navbar) return;

    // Scrolled morph class
    if (currentScrollY > 15) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }

    // Directional hide/reveal (do not hide if mobile drawer is open)
    if (!isMobileMenuOpen) {
      if (currentScrollY <= 60) {
        navbar.classList.remove('navbar--hidden');
      } else if (currentScrollY > lastScrollY + delta) {
        navbar.classList.add('navbar--hidden');
      } else if (currentScrollY < lastScrollY - delta) {
        navbar.classList.remove('navbar--hidden');
      }
    }

    lastScrollY = Math.max(0, currentScrollY);
  }

  // Initial call
  updateScrollState();

  // RAF throttled scroll listener
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateScrollState();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  // 2. Mobile Drawer Toggle Logic
  function toggleMobileMenu(forceState) {
    if (!mobileToggle || !mobileDrawer || !navbar) return;
    
    isMobileMenuOpen = typeof forceState === 'boolean' ? forceState : !isMobileMenuOpen;
    
    mobileToggle.setAttribute('aria-expanded', String(isMobileMenuOpen));
    mobileToggle.classList.toggle('is-active', isMobileMenuOpen);
    mobileDrawer.classList.toggle('is-open', isMobileMenuOpen);
    mobileDrawer.setAttribute('aria-hidden', String(!isMobileMenuOpen));
    if (isMobileMenuOpen) {
      mobileDrawer.removeAttribute('inert');
    } else {
      mobileDrawer.setAttribute('inert', '');
    }
    navbar.classList.toggle('drawer-open', isMobileMenuOpen);

    // Keep navbar visible when menu is open
    if (isMobileMenuOpen) {
      navbar.classList.remove('navbar--hidden');
    }
  }

  mobileToggle?.addEventListener('click', () => toggleMobileMenu());

  // Close drawer on link click
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => toggleMobileMenu(false));
  });

  // Close on Escape key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMobileMenuOpen) {
      toggleMobileMenu(false);
    }
  });
</script>

<style>
  /* ── Desktop Capsule Floating Navbar ── */
  .navbar {
    position: fixed;
    top: 1rem;
    left: 1.25rem;
    right: 1.25rem;
    max-width: 1200px;
    margin: 0 auto;
    z-index: var(--z-nav);
    border-radius: var(--radius-full);
    background-color: rgba(253, 250, 247, 0.72);
    backdrop-filter: blur(16px) saturate(1.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    border: 1px solid rgba(139, 26, 74, 0.09);
    box-shadow: 0 4px 20px -2px rgba(28, 28, 28, 0.03),
                0 1px 3px rgba(139, 26, 74, 0.02);
    transition: transform 380ms var(--ease-out),
                background-color 300ms var(--ease-out),
                box-shadow 300ms var(--ease-out),
                border-color 300ms var(--ease-out),
                padding 300ms var(--ease-out);
    will-change: transform, background-color, box-shadow;
  }

  /* Directional Smart Hide */
  .navbar.navbar--hidden {
    transform: translateY(-135%);
  }

  /* Morphing Scrolled State */
  .navbar.scrolled {
    top: 0.75rem;
    background-color: rgba(250, 246, 243, 0.94);
    backdrop-filter: blur(28px) saturate(1.9);
    -webkit-backdrop-filter: blur(28px) saturate(1.9);
    box-shadow: 0 12px 36px -6px rgba(139, 26, 74, 0.11),
                0 2px 10px rgba(28, 28, 28, 0.04);
    border: 1px solid rgba(139, 26, 74, 0.16);
  }

  /* ── Embedded Scroll Progress Bar ── */
  .navbar__progress-track {
    position: absolute;
    bottom: 0;
    left: 1.5rem;
    right: 1.5rem;
    height: 2px;
    border-radius: 2px;
    overflow: hidden;
    pointer-events: none;
  }

  .navbar__progress-bar {
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--color-rose-light), var(--color-rose), var(--color-gold));
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 60ms linear;
    will-change: transform;
    border-radius: inherit;
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.35rem;
    gap: var(--space-md);
    transition: padding 300ms var(--ease-out);
  }

  .navbar.scrolled .navbar__inner {
    padding: 0.45rem 1.2rem;
  }

  /* ── Logo ── */
  .navbar__logo {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    min-height: 40px;
    padding: 0 0.35rem;
    border-radius: var(--radius-md);
    transition: transform 200ms var(--ease-out), opacity 200ms var(--ease-out);
  }

  .navbar__logo:hover {
    transform: scale(1.02);
    opacity: 0.92;
  }

  .navbar__logo-sparkle {
    color: var(--color-rose);
    font-size: 0.9rem;
    animation: sparkle-pulse 3s infinite ease-in-out;
  }

  @keyframes sparkle-pulse {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.9; }
    50% { transform: scale(1.18) rotate(15deg); opacity: 1; }
  }

  .navbar__logo-text {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    font-style: italic;
    background: linear-gradient(135deg, var(--color-rose-dark) 0%, var(--color-rose) 60%, var(--color-rose-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .navbar__logo-divider {
    color: var(--color-blush);
    font-size: 0.85rem;
    opacity: 0.8;
  }

  .navbar__logo-full {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ── Desktop Nav Links ── */
  .navbar__links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    background: rgba(139, 26, 74, 0.03);
    padding: 3px 6px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(139, 26, 74, 0.05);
  }

  .navbar__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 38px;
    padding: 0.4rem 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-full);
    transition: color 200ms var(--ease-out), background-color 200ms var(--ease-out), transform 150ms var(--ease-out);
  }

  .navbar__link:hover {
    color: var(--color-rose);
    background-color: rgba(139, 26, 74, 0.06);
  }

  .navbar__link--active {
    color: var(--color-rose);
    font-weight: 600;
    background-color: rgba(255, 255, 255, 0.9);
    box-shadow: 0 2px 10px rgba(139, 26, 74, 0.08);
  }

  .navbar__active-indicator {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background-color: var(--color-rose);
    box-shadow: 0 0 6px var(--color-rose-light);
    display: inline-block;
  }

  /* ── Actions Right Group ── */
  .navbar__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Search button pill */
  .navbar__search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.9rem;
    min-height: 40px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(139, 26, 74, 0.12);
    background-color: rgba(255, 255, 255, 0.75);
    color: var(--color-text-muted);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    transition: color 200ms var(--ease-out),
                background-color 200ms var(--ease-out),
                border-color 200ms var(--ease-out),
                box-shadow 200ms var(--ease-out),
                transform 150ms var(--ease-out);
  }

  .navbar__search-btn:hover {
    color: var(--color-rose);
    border-color: rgba(139, 26, 74, 0.28);
    background-color: var(--color-blush-light);
    box-shadow: 0 4px 14px rgba(139, 26, 74, 0.12);
    transform: translateY(-1px);
  }

  .navbar__search-icon {
    color: var(--color-rose);
    transition: transform 200ms var(--ease-out);
  }

  .navbar__search-btn:hover .navbar__search-icon {
    transform: scale(1.1) rotate(-8deg);
  }

  .navbar__search-label {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .navbar__search-kbd {
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 600;
    background-color: rgba(139, 26, 74, 0.06);
    border: 1px solid rgba(139, 26, 74, 0.12);
    border-radius: 4px;
    padding: 1px 5px;
    color: var(--color-rose);
    letter-spacing: 0.05em;
  }

  /* ── Mobile Hamburger Toggle Button ── */
  .navbar__mobile-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    min-height: 42px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(139, 26, 74, 0.12);
    background-color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    transition: background-color 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }

  .navbar__mobile-toggle:hover {
    background-color: var(--color-blush-light);
    border-color: var(--color-rose-light);
  }

  .hamburger-box {
    position: relative;
    width: 18px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hamburger-inner,
  .hamburger-inner::before,
  .hamburger-inner::after {
    position: absolute;
    width: 18px;
    height: 2px;
    background-color: var(--color-rose);
    border-radius: 2px;
    transition: transform 250ms var(--ease-out), opacity 200ms var(--ease-out);
  }

  .hamburger-inner {
    top: 50%;
    transform: translateY(-50%);
  }

  .hamburger-inner::before {
    content: '';
    top: -6px;
  }

  .hamburger-inner::after {
    content: '';
    bottom: -6px;
  }

  /* Hamburger active X morph */
  .navbar__mobile-toggle.is-active .hamburger-inner {
    background-color: transparent;
  }

  .navbar__mobile-toggle.is-active .hamburger-inner::before {
    transform: translateY(6px) rotate(45deg);
  }

  .navbar__mobile-toggle.is-active .hamburger-inner::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ── Mobile Drawer Dropdown Panel ── */
  .mobile-drawer {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    background: rgba(253, 250, 247, 0.96);
    backdrop-filter: blur(28px) saturate(1.8);
    -webkit-backdrop-filter: blur(28px) saturate(1.8);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(139, 26, 74, 0.14);
    box-shadow: 0 16px 40px -8px rgba(139, 26, 74, 0.16);
    padding: 1.25rem;
    opacity: 0;
    transform: translateY(-12px) scale(0.98);
    pointer-events: none;
    transition: opacity 250ms var(--ease-out), transform 250ms var(--ease-out);
  }

  .mobile-drawer.is-open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .mobile-drawer__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mobile-drawer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out);
  }

  .mobile-drawer__link:hover,
  .mobile-drawer__link--active {
    background-color: rgba(139, 26, 74, 0.07);
    color: var(--color-rose);
  }

  .mobile-drawer__active-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--color-rose);
    box-shadow: 0 0 6px var(--color-rose);
  }

  .mobile-drawer__footer {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(139, 26, 74, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-drawer__search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 44px;
    padding: 0.6rem 1rem;
    background-color: var(--color-rose);
    color: #FFFFFF;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--radius-full);
    box-shadow: 0 4px 14px rgba(139, 26, 74, 0.25);
    transition: background-color 200ms var(--ease-out), transform 150ms var(--ease-out);
  }

  .mobile-drawer__search-btn:active {
    transform: scale(0.98);
  }

  .mobile-drawer__badge {
    text-align: center;
    font-size: 0.68rem;
    font-family: var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  /* ── Mobile Layout Adjustments (< 860px) ── */
  @media (max-width: 859px) {
    .navbar {
      top: 0.5rem;
      left: 0.75rem;
      right: 0.75rem;
      border-radius: 24px;
    }

    .navbar__inner {
      padding: 0.45rem 0.85rem;
    }

    .navbar__links {
      display: none;
    }

    .navbar__logo-full,
    .navbar__logo-divider {
      display: none;
    }

    .navbar__search-kbd,
    .navbar__search-label {
      display: none;
    }

    .navbar__search-btn {
      padding: 0.35rem 0.6rem;
      min-height: 38px;
    }

    .navbar__mobile-toggle {
      display: flex;
    }

    .mobile-drawer {
      display: block;
    }

    .navbar__progress-track {
      left: 1rem;
      right: 1rem;
    }
  }

  /* Reduced Motion accessibility override */
  @media (prefers-reduced-motion: reduce) {
    .navbar,
    .navbar__logo-sparkle,
    .navbar__search-btn,
    .mobile-drawer,
    .navbar__progress-bar {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

