---
import NewsletterSubscribe from '../ui/NewsletterSubscribe.astro';
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer__grid">
      <!-- Brand & Tagline -->
      <div class="footer__col footer__col--brand">
        <a href="/" class="footer__logo" aria-label="NailSet Gallery — Home">
          <span aria-hidden="true">✦</span> NailSet Gallery
        </a>
        <p class="footer__tagline">
          Your luxury gallery for nail art inspiration, seasonal color palettes, and expert manicure tutorials.
        </p>
        <div class="footer__socials">
          <a href="https://www.pinterest.com/ayastickers21/" target="_blank" rel="noopener noreferrer" class="footer__social-link" title="Follow us on Pinterest">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.367 18.62 0 12.017 0z"/>
            </svg>
            <span>Pinterest</span>
          </a>
          <a href="/rss.xml" class="footer__social-link" title="Subscribe to RSS Feed">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
            <span>RSS Feed</span>
          </a>
        </div>
      </div>

      <!-- Quick Links: Categories -->
      <div class="footer__col">
        <h4 class="footer__heading">Categories</h4>
        <ul class="footer__links-list" role="list">
          <li><a href="/colors/">Nail Colors</a></li>
          <li><a href="/styles/">Nail Styles</a></li>
          <li><a href="/seasons/">Seasons</a></li>
          <li><a href="/trends/">2026 Trends</a></li>
          <li><a href="/tutorials/">Tutorials & Care</a></li>
        </ul>
      </div>

      <!-- Quick Links: Gallery & Info -->
      <div class="footer__col">
        <h4 class="footer__heading">Explore</h4>
        <ul class="footer__links-list" role="list">
          <li><a href="/blog/">All Articles</a></li>
          <li><a href="/quiz/">Nail Quiz</a></li>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Service</a></li>
          <li><a href="/disclaimer/">Disclaimer</a></li>
        </ul>
      </div>

      <!-- Newsletter Column -->
      <div class="footer__col footer__col--newsletter">
        <NewsletterSubscribe variant="compact" />
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer__bottom">
      <p class="footer__copy">
        © {new Date().getFullYear()} NailSet Gallery. All rights reserved.
      </p>
      <button class="footer__back-top" id="back-to-top" aria-label="Back to top of page">
        <span>Back to top</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="19" x2="12" y2="5"></line>
          <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
      </button>
    </div>
  </div>
</footer>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top');
    btn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  setupBackToTop();
  document.addEventListener('astro:page-load', setupBackToTop);
</script>

<style>
  .footer {
    background-color: var(--color-bg-deep);
    border-top: 1px solid var(--color-border-soft);
    padding-top: var(--space-3xl);
    padding-bottom: calc(var(--space-2xl) + 70px);
  }

  @media (min-width: 768px) {
    .footer {
      padding-bottom: var(--space-2xl);
    }
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 2.2fr;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .footer__logo {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-2xl);
    font-weight: 300;
    color: var(--color-rose);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-sm);
  }

  .footer__tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 32ch;
  }

  .footer__socials {
    margin-top: var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__social-link:hover {
    color: var(--color-rose);
  }

  .footer__heading {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    font-weight: 400;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .footer__links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer__links-list a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
    display: inline-block;
    padding: 2px 0;
  }

  .footer__links-list a:hover {
    color: var(--color-rose);
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-lg);
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .footer__copy {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .footer__back-top {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    background: none;
    border: none;
    font-family: inherit;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
    padding: var(--space-xs);
  }

  .footer__back-top:hover {
    color: var(--color-rose);
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  @media (max-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
