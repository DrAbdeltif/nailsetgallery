---
interface HubLink {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  answer: string;
  links: HubLink[];
}

const { eyebrow, heading, intro, answer, links } = Astro.props;
---

<section class="hub-intro" aria-labelledby="hub-intro-heading">
  <p class="label label-rose">{eyebrow}</p>
  <h2 id="hub-intro-heading" class="hub-intro__heading">{heading}</h2>
  <p class="hub-intro__copy">{intro}</p>
  <div class="hub-intro__answer">
    <strong>Quick answer</strong>
    <p>{answer}</p>
  </div>
  <nav aria-label={`${heading} guides`} class="hub-intro__links">
    <span class="hub-intro__links-label">Start with a guide:</span>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</section>

<style>
  .hub-intro {
    max-width: 860px;
    margin: 0 0 var(--space-2xl);
    padding: var(--space-xl);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-lg);
    background: var(--color-bg-deep);
  }

  .hub-intro__heading {
    margin: var(--space-xs) 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    font-style: italic;
    line-height: var(--leading-snug);
  }

  .hub-intro__copy,
  .hub-intro__answer p {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .hub-intro__answer {
    margin-top: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    border-left: 3px solid var(--color-rose);
    background: var(--color-bg-card);
  }

  .hub-intro__answer strong { color: var(--color-text); }
  .hub-intro__answer p { margin-top: var(--space-xs); }

  .hub-intro__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
  }

  .hub-intro__links-label { color: var(--color-text-subtle); }
  .hub-intro__links a { color: var(--color-rose); text-underline-offset: 3px; }

  @media (max-width: 767px) {
    .hub-intro { padding: var(--space-lg); }
  }
</style>
