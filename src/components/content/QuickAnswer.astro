---
// QuickAnswer.astro — AEO / GEO Optimization Summary Box
// Provides concise factual answers and key takeaways for AI search engines (ChatGPT, Perplexity, Google AI Overviews).

interface TakeawayItem {
  label: string; // e.g. 'Best Shape', 'Longevity', 'Difficulty', 'Finish'
  value: string;
}

interface Props {
  answerText: string;
  takeaways?: TakeawayItem[];
  title?: string;
}

const {
  answerText,
  takeaways = [],
  title = '✦ Quick Answer & Key Takeaways',
} = Astro.props;
---

<section class="quick-answer reveal-fade" aria-label="Quick Answer and Key Takeaways">
  <div class="quick-answer__header">
    <span class="quick-answer__badge">AI Summary & Guide</span>
    <h2 class="quick-answer__title">{title}</h2>
  </div>

  <p class="quick-answer__text">{answerText}</p>

  {takeaways.length > 0 && (
    <div class="quick-answer__takeaways">
      {takeaways.map((item) => (
        <div class="takeaway-chip">
          <strong class="takeaway-chip__label">{item.label}:</strong>
          <span class="takeaway-chip__val">{item.value}</span>
        </div>
      ))}
    </div>
  )}
</section>

<style>
  .quick-answer {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-rose);
    border-radius: var(--radius-md);
    padding: var(--space-lg) var(--space-xl);
    margin: var(--space-xl) 0;
    box-shadow: var(--shadow-sm);
  }

  .quick-answer__header {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: var(--space-xs);
  }

  .quick-answer__badge {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-rose);
  }

  .quick-answer__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    font-style: italic;
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .quick-answer__text {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-top: var(--space-xs);
  }

  .quick-answer__takeaways {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px dashed var(--color-border-soft);
  }

  .takeaway-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--color-bg-deep);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-full);
    padding: 6px 14px;
    font-size: var(--text-xs);
  }

  .takeaway-chip__label {
    color: var(--color-rose);
    font-weight: 600;
  }

  .takeaway-chip__val {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .quick-answer {
      padding: var(--space-md) var(--space-lg);
    }
  }
</style>
