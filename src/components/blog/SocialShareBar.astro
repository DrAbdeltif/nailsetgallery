---
// SocialShareBar.astro — Modern Social Sharing Bar with Native Web Share & Copy Link Toast
interface Props {
  url: string;
  title: string;
  description?: string;
  media?: string;
}

const { url, title, description = '', media = '' } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedDesc = encodeURIComponent(description);
const encodedMedia = encodeURIComponent(media);

const pinterestUrl = `https://pinterest.com/pin/create/button/?url=${encodedUrl}&media=${encodedMedia}&description=${encodedTitle}`;
const twitterUrl = `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const whatsappUrl = `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`;
---

<div class="social-share-bar" aria-label="Share this article">
  <span class="social-share-label">Share:</span>

  <div class="social-share-actions">
    <!-- Native Web Share / Copy Link -->
    <button class="share-btn share-btn--copy" id="copy-link-btn" title="Copy Link" aria-label="Copy article link" data-url={url} data-title={title}>
      <svg class="icon-link" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
      <span class="btn-text">Copy Link</span>
    </button>

    <!-- Pinterest -->
    <a href={pinterestUrl} target="_blank" rel="noopener noreferrer" class="share-btn share-btn--pinterest" title="Save to Pinterest" aria-label="Save to Pinterest">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"></path>
      </svg>
      <span class="btn-text">Pin</span>
    </a>

    <!-- X / Twitter -->
    <a href={twitterUrl} target="_blank" rel="noopener noreferrer" class="share-btn share-btn--twitter" title="Share on X" aria-label="Share on X (Twitter)">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
      </svg>
      <span class="btn-text">Share</span>
    </a>

    <!-- WhatsApp -->
    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="share-btn share-btn--whatsapp" title="Share on WhatsApp" aria-label="Share on WhatsApp">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"></path>
      </svg>
      <span class="btn-text">WhatsApp</span>
    </a>
  </div>

  <!-- Copied Toast Banner -->
  <div class="toast-copied" id="copied-toast" role="status" aria-live="polite">
    ✓ Link copied to clipboard!
  </div>
</div>

<style>
  .social-share-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    flex-wrap: wrap;
  }

  .social-share-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .social-share-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid var(--color-border-soft);
    background: var(--color-bg);
    color: var(--color-text);
    transition: all var(--duration-fast) var(--ease-out);
    min-height: 36px;
  }

  .share-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .share-btn--copy:hover {
    background-color: var(--color-rose);
    color: #FFFFFF;
    border-color: var(--color-rose);
  }

  .share-btn--pinterest:hover {
    background-color: #E60023;
    color: #FFFFFF;
    border-color: #E60023;
  }

  .share-btn--twitter:hover {
    background-color: #000000;
    color: #FFFFFF;
    border-color: #000000;
  }

  .share-btn--whatsapp:hover {
    background-color: #25D366;
    color: #FFFFFF;
    border-color: #25D366;
  }

  .toast-copied {
    position: absolute;
    top: -42px;
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: var(--color-text);
    color: #FFFFFF;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    opacity: 0;
    pointer-events: none;
    transition: all var(--duration-fast) var(--ease-out);
    box-shadow: var(--shadow-card);
    white-space: nowrap;
  }

  .toast-copied.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (max-width: 600px) {
    .social-share-bar {
      border-radius: var(--radius-md);
      justify-content: space-between;
    }
    .btn-text {
      display: none;
    }
    .share-btn {
      padding: 8px 10px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('copy-link-btn');
    const toast = document.getElementById('copied-toast');

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const url = copyBtn.getAttribute('data-url') || window.location.href;
        const title = copyBtn.getAttribute('data-title') || document.title;

        // Try Native Web Share API on mobile first
        if (navigator.share && window.innerWidth <= 768) {
          try {
            await navigator.share({ title, url });
            return;
          } catch (err) {
            // Fallback to clipboard if user cancels or fails
          }
        }

        // Fallback to Clipboard API
        try {
          await navigator.clipboard.writeText(url);
          if (toast) {
            toast.classList.add('show');
            setTimeout(() => {
              toast.classList.remove('show');
            }, 2500);
          }
        } catch (err) {
          console.error('Failed to copy link: ', err);
        }
      });
    }
  });
</script>
