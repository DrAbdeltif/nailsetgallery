---
interface PostLink {
  id: string;
  title: string;
  heroImage?: string;
  category?: string;
}

export interface Props {
  prevPost?: PostLink | null;
  nextPost?: PostLink | null;
}

const { prevPost, nextPost } = Astro.props;
---

{(prevPost || nextPost) && (
  <nav class="article-nav container" aria-label="Article navigation">
    <div class="article-nav__grid">
      {prevPost ? (
        <a href={`/blog/${prevPost.id}/`} class="article-nav__card article-nav__card--prev">
          <div class="article-nav__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </div>
          {prevPost.heroImage && (
            <div class="article-nav__thumb">
              <img src={prevPost.heroImage} alt="" loading="lazy" decoding="async" />
            </div>
          )}
          <div class="article-nav__content">
            <span class="article-nav__label">← Previous Article</span>
            <span class="article-nav__title">{prevPost.title}</span>
          </div>
        </a>
      ) : (
        <div class="article-nav__spacer"></div>
      )}

      {nextPost ? (
        <a href={`/blog/${nextPost.id}/`} class="article-nav__card article-nav__card--next">
          <div class="article-nav__content">
            <span class="article-nav__label">Next Article →</span>
            <span class="article-nav__title">{nextPost.title}</span>
          </div>
          {nextPost.heroImage && (
            <div class="article-nav__thumb">
              <img src={nextPost.heroImage} alt="" loading="lazy" decoding="async" />
            </div>
          )}
          <div class="article-nav__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      ) : (
        <div class="article-nav__spacer"></div>
      )}
    </div>
  </nav>
)}

<style>
  .article-nav {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .article-nav__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .article-nav__spacer {
    display: block;
  }

  .article-nav__card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    transition: transform var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
    box-shadow: var(--shadow-sm);
  }

  .article-nav__card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border);
    box-shadow: var(--shadow-card);
  }

  .article-nav__card--next {
    text-align: right;
    justify-content: flex-end;
  }

  .article-nav__card--prev {
    text-align: left;
    justify-content: flex-start;
  }

  .article-nav__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-deep);
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .article-nav__card:hover .article-nav__icon {
    background-color: var(--color-rose);
    color: #ffffff;
  }

  .article-nav__thumb {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
    background-color: var(--color-bg-deep);
  }

  .article-nav__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .article-nav__card:hover .article-nav__thumb img {
    transform: scale(1.05);
  }

  .article-nav__content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    flex: 1;
  }

  .article-nav__label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--color-rose);
  }

  .article-nav__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-style: italic;
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .article-nav__card:hover .article-nav__title {
    color: var(--color-rose);
  }

  @media (max-width: 640px) {
    .article-nav__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .article-nav__spacer {
      display: none;
    }

    .article-nav__card--next {
      text-align: left;
      justify-content: flex-start;
      flex-direction: row-reverse;
    }

    .article-nav__card--next .article-nav__content {
      text-align: right;
    }
  }
</style>
