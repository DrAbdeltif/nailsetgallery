---
// TableOfContents.astro — Interactive Table of Contents for Blog Articles
export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
}

const { headings } = Astro.props;

// Filter to H2 and H3 headings
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav class="toc-widget reveal-fade" aria-label="Table of Contents">
    <details class="toc-details" open>
      <summary class="toc-summary">
        <div class="toc-title-wrapper">
          <svg class="toc-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
          <span class="toc-title">Table of Contents</span>
        </div>
        <svg class="toc-chevron" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </summary>

      <ul class="toc-list" role="list">
        {filteredHeadings.map((heading) => (
          <li class={`toc-item toc-item--h${heading.depth}`}>
            <a href={`#${heading.slug}`} class="toc-link" data-toc-slug={heading.slug}>
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
)}

<style>
  .toc-widget {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    margin-bottom: var(--space-xl);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--duration-normal) var(--ease-out);
  }

  .toc-widget:hover {
    box-shadow: var(--shadow-card);
  }

  .toc-details[open] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    user-select: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-title-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .toc-icon {
    color: var(--color-rose);
  }

  .toc-chevron {
    color: var(--color-text-muted);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .toc-list {
    margin-top: var(--space-md);
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid var(--color-border-soft);
    padding-top: var(--space-sm);
  }

  .toc-item--h2 {
    font-weight: 500;
    font-size: var(--text-sm);
  }

  .toc-item--h3 {
    padding-left: var(--space-md);
    font-size: var(--text-xs);
  }

  .toc-link {
    color: var(--color-text-muted);
    text-decoration: none;
    display: inline-block;
    padding: 3px 6px;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast) var(--ease-out);
    line-height: 1.4;
  }

  .toc-link:hover,
  .toc-link.active {
    color: var(--color-rose);
    background-color: var(--color-blush-light);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .toc-widget {
      margin-bottom: var(--space-lg);
    }
  }
</style>

<script>
  // ScrollSpy to highlight active heading link in TOC
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            if (id) {
              document.querySelectorAll('.toc-link').forEach((link) => {
                link.classList.toggle('active', link.getAttribute('data-toc-slug') === id);
              });
            }
          }
        });
      },
      { rootMargin: '-80px 0px -60% 0px' }
    );

    document.querySelectorAll('.prose h2, .prose h3').forEach((heading) => {
      observer.observe(heading);
    });
  });
</script>
