---
interface Props {
  client?: string;
  slot?: string;
  format?: 'auto' | 'fluid' | 'rectangle' | 'horizontal' | 'vertical';
  responsive?: boolean;
  class?: string;
  style?: string;
}

const {
  client = import.meta.env.PUBLIC_GOOGLE_ADSENSE_ID || '',
  slot = '',
  format = 'auto',
  responsive = true,
  class: className = '',
  style = '',
} = Astro.props;

const isDev = import.meta.env.DEV;
---

{client || isDev ? (
  <div class:list={['adsense-container', className]}>
    {isDev && !client ? (
      <div class="adsense-placeholder" style={style}>
        <div class="adsense-placeholder__badge">✦ Google AdSense Placeholder</div>
        <div class="adsense-placeholder__info">
          {slot ? `Slot ID: ${slot}` : 'Auto-Ads / Display Unit'}
        </div>
      </div>
    ) : (
      <ins
        class="adsbygoogle"
        style={style || "display:block"}
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format={format}
        data-full-width-responsive={responsive ? "true" : "false"}
      ></ins>
    )}
  </div>
) : null}

<script is:inline>
  if (typeof window !== 'undefined' && window.adsbygoogle) {
    try {
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    } catch (e) {
      console.error('AdSense initialization error:', e);
    }
  }
</script>

<style>
  .adsense-container {
    width: 100%;
    margin: var(--space-xl, 2rem) 0;
    text-align: center;
    overflow: hidden;
    min-height: 90px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .adsense-placeholder {
    width: 100%;
    min-height: 120px;
    background: var(--color-bg-card, rgba(255, 255, 255, 0.03));
    border: 1px dashed var(--color-border-soft, rgba(255, 255, 255, 0.15));
    border-radius: var(--radius-md, 8px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-md, 1rem);
    gap: 6px;
  }

  .adsense-placeholder__badge {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-rose, #e0a96d);
  }

  .adsense-placeholder__info {
    font-size: 12px;
    color: var(--color-text-muted, #a0a0a0);
  }
</style>
