---
// PinterestSaveButton.astro — Lightweight Pinterest Save & Share Button
// Zero render-blocking scripts. Direct Pinterest API pin generator URL.

interface Props {
  url?: string;
  media?: string;
  description?: string;
  variant?: 'floating' | 'inline' | 'card';
  class?: string;
}

const {
  url = Astro.url.href,
  media = 'https://nailsetgallery.com/images/og-default.jpg',
  description = 'Beautiful nail set art inspiration & manicure designs — NailSetGallery.com',
  variant = 'inline',
  class: className = '',
} = Astro.props;

const pinUrl = `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&media=${encodeURIComponent(media.startsWith('http') ? media : `https://nailsetgallery.com${media}`)}&description=${encodeURIComponent(description)}`;
---

<a
  href={pinUrl}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['pinterest-save-btn', `pinterest-save-btn--${variant}`, className]}
  aria-label="Save this nail look to Pinterest (opens in new window)"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.367 18.62 0 12.017 0z"/>
  </svg>
  <span>Save to Pinterest</span>
</a>

<style>
  .pinterest-save-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: #E60023;
    color: #FFFFFF;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 8px 14px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
    box-shadow: var(--shadow-sm);
    min-height: 36px;
  }

  .pinterest-save-btn:hover {
    background-color: #AD001A;
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .pinterest-save-btn--floating {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    z-index: 10;
  }

  .pinterest-save-btn--card {
    padding: 6px 10px;
    font-size: 11px;
    min-height: 32px;
  }
</style>
