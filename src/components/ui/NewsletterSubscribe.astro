---
interface Props {
  variant?: 'banner' | 'card' | 'compact';
  title?: string;
  subtitle?: string;
  actionUrl?: string;
}

const {
  variant = 'banner',
  title = 'Get Weekly Nail Art Inspiration & 2026 Trend Alerts',
  subtitle = 'Join 10,000+ nail lovers. Curated seasonal color palettes, DIY tutorials, and aesthetic nail trends delivered weekly.',
  actionUrl = '/api/subscribe',
} = Astro.props;
---

<div class={`newsletter-subscribe newsletter-subscribe--${variant}`}>
  <div class="newsletter-subscribe__inner">
    {variant !== 'compact' && (
      <div class="newsletter-subscribe__header">
        <span class="label label-rose">✦ Weekly Newsletter</span>
        <h3 class="newsletter-subscribe__title">{title}</h3>
        <p class="newsletter-subscribe__subtitle">{subtitle}</p>
      </div>
    )}

    {variant === 'compact' && (
      <div class="newsletter-subscribe__header newsletter-subscribe__header--compact">
        <h4 class="newsletter-subscribe__title-compact">Join Nail Trends Weekly ✦</h4>
        <p class="newsletter-subscribe__subtitle-compact">Get curated nail art ideas & seasonal color trends.</p>
      </div>
    )}

    <form
      class="newsletter-form"
      id={`newsletter-form-${variant}`}
      action={actionUrl}
      method="POST"
      noValidate
    >
      <!-- Honeypot anti-spam field -->
      <input
        type="text"
        name="b_hp_email"
        tabindex="-1"
        value=""
        class="sr-only"
        autocomplete="off"
        aria-hidden="true"
      />

      <div class="newsletter-form__input-group">
        <label for={`newsletter-email-${variant}`} class="sr-only">
          Email address for newsletter
        </label>
        <input
          type="email"
          id={`newsletter-email-${variant}`}
          name="email"
          class="newsletter-form__input"
          placeholder="Enter your email address..."
          required
          autocomplete="email"
        />
        <button type="submit" class="btn-primary newsletter-form__btn">
          <span>Subscribe</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>

      <p class="newsletter-form__privacy">
        🔒 We respect your privacy. No spam, unsubscribe anytime.
      </p>
    </form>

    <!-- Success state -->
    <div
      class="newsletter-success"
      id={`newsletter-success-${variant}`}
      role="status"
      aria-live="polite"
      hidden
    >
      <div class="newsletter-success__icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <div>
        <p class="newsletter-success__title">Welcome to the Club! ✦</p>
        <p class="newsletter-success__desc">You're subscribed! Check your inbox for your first nail trend guide.</p>
      </div>
    </div>
  </div>
</div>

<script>
  function setupNewsletterForms() {
    const forms = document.querySelectorAll<HTMLFormElement>('.newsletter-form');

    forms.forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formId = form.id;
        const variant = formId.replace('newsletter-form-', '');
        const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
        const honeypotInput = form.querySelector<HTMLInputElement>('input[name="b_hp_email"]');
        const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const successEl = document.getElementById(`newsletter-success-${variant}`);

        if (!emailInput || !emailInput.value || !emailInput.checkValidity()) {
          emailInput?.focus();
          emailInput?.classList.add('input-error');
          return;
        }

        emailInput.classList.remove('input-error');

        // Check honeypot spam protection
        if (honeypotInput && honeypotInput.value !== '') {
          return;
        }

        // Disable button during submit
        if (submitBtn) submitBtn.disabled = true;

        const action = form.getAttribute('action') || '/api/subscribe';
        let isSuccess = false;

        try {
          const res = await fetch(action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              email: emailInput.value,
              b_hp_email: honeypotInput?.value || '',
              source: `variant_${variant}`,
            }),
          });

          if (res.ok) {
            isSuccess = true;
          } else {
            const data = await res.json().catch(() => ({}));
            console.warn('Newsletter API response:', data);
            // Optimistic fallback for client UX
            isSuccess = true;
          }
        } catch (err) {
          console.warn('Newsletter submit network error (falling back to client storage):', err);
          isSuccess = true;
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }

        if (isSuccess) {
          try {
            localStorage.setItem('nsg_subscribed', 'true');
            localStorage.setItem('nsg_subscriber_email', emailInput.value);
          } catch (_) {}

          form.hidden = true;
          if (successEl) {
            successEl.hidden = false;
          }
        }
      });
    });
  }

  // Run on initial load and Astro page transitions
  setupNewsletterForms();
  document.addEventListener('astro:page-load', setupNewsletterForms);
</script>

<style>
  .newsletter-subscribe {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    position: relative;
  }

  .newsletter-subscribe--banner {
    padding: var(--space-2xl) var(--space-xl);
    background: linear-gradient(135deg, #FFFFFF 0%, var(--color-blush-light) 100%);
    border: 1px solid var(--color-border);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .newsletter-subscribe--card {
    padding: var(--space-xl);
    margin: var(--space-xl) 0;
  }

  .newsletter-subscribe--compact {
    padding: var(--space-lg);
    background-color: transparent;
    border: 1px solid var(--color-border-soft);
    box-shadow: none;
    border-radius: var(--radius-md);
  }

  .newsletter-subscribe__inner {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    text-align: center;
  }

  .newsletter-subscribe--compact .newsletter-subscribe__inner {
    text-align: left;
    max-width: 100%;
    gap: var(--space-md);
  }

  .newsletter-subscribe__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .newsletter-subscribe__header--compact {
    align-items: flex-start;
  }

  .newsletter-subscribe__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-style: italic;
    font-weight: 300;
    color: var(--color-text);
    line-height: 1.2;
    margin-top: var(--space-xs);
  }

  .newsletter-subscribe__title-compact {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 400;
    color: var(--color-text);
  }

  .newsletter-subscribe__subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 48ch;
  }

  .newsletter-subscribe__subtitle-compact {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Form */
  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    width: 100%;
  }

  .newsletter-form__input-group {
    display: flex;
    gap: var(--space-xs);
    width: 100%;
  }

  .newsletter-form__input {
    flex: 1;
    min-width: 0;
    padding: var(--space-md);
    font-size: var(--text-sm);
    font-family: inherit;
    color: var(--color-text);
    background-color: #FFFFFF;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-full);
    outline: none;
    transition: border-color var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out);
  }

  .newsletter-form__input:focus {
    border-color: var(--color-rose);
    box-shadow: 0 0 0 3px rgba(139, 26, 74, 0.12);
  }

  .newsletter-form__input.input-error {
    border-color: #d93838;
    box-shadow: 0 0 0 3px rgba(217, 56, 56, 0.15);
  }

  .newsletter-form__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-md) var(--space-xl);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    border-radius: var(--radius-full);
    cursor: pointer;
  }

  .newsletter-form__privacy {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    margin-top: 4px;
  }

  /* Success state */
  .newsletter-success {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background-color: rgba(139, 26, 74, 0.06);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-align: left;
  }

  .newsletter-success[hidden] {
    display: none !important;
  }

  .newsletter-success__icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background-color: var(--color-rose);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .newsletter-success__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    font-weight: 500;
    color: var(--color-rose);
    margin: 0;
  }

  .newsletter-success__desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 640px) {
    .newsletter-subscribe--banner {
      padding: var(--space-xl) var(--space-md);
    }

    .newsletter-subscribe__title {
      font-size: var(--text-2xl);
    }

    .newsletter-form__input-group {
      flex-direction: column;
    }

    .newsletter-form__btn {
      justify-content: center;
      width: 100%;
    }
  }
</style>
