---
// ShopTheLook.astro — Curated Affiliate Product Recommendation Component
// Features FTC Disclosure, responsive product cards, and SEO-safe affiliate links.

interface ProductItem {
  title: string;
  category: string; // e.g. 'Gel Polish', 'Chrome Powder', 'Nail Lamp', 'Prep & Care'
  description?: string;
  image?: string;
  affiliateUrl: string;
  badge?: string; // e.g. 'Must-Have', 'Top Pick', 'Salon Grade'
}

interface Props {
  heading?: string;
  subheading?: string;
  products?: ProductItem[];
}

const defaultProducts: ProductItem[] = [
  {
    title: 'Professional LED/UV Nail Lamp 48W',
    category: 'Nail Lamp',
    description: 'Fast dual-light cure for builder gels, Gel-X tips, and chrome top coats.',
    affiliateUrl: 'https://amazon.com/dp/B08D1K8M92?tag=nailsetgall07-20',
    badge: 'Essential',
  },
  {
    title: 'Non-Wipe Glazed Chrome Top Coat Set',
    category: 'Chrome & Finish',
    description: 'Ultra-glossy non-wipe top coat engineered for mirror chrome powder adherence.',
    affiliateUrl: 'https://amazon.com/dp/B09G3F1K1L?tag=nailsetgall07-20',
    badge: 'Top Pick',
  },
  {
    title: 'Professional Cuticle Oil Rollerball Pen',
    category: 'Nail Care',
    description: 'Nourishing jojoba and vitamin E blend for hydrated cuticles and long-lasting manicures.',
    affiliateUrl: 'https://amazon.com/dp/B07V2C67NW?tag=nailsetgall07-20',
    badge: 'Daily Care',
  },
];

const {
  heading = '✦ Recreate The Look: Recommended Products & Tools',
  subheading = 'Curated salon-tested tools and finishes to achieve professional results at home.',
  products = defaultProducts,
} = Astro.props;
---

<aside class="shop-the-look reveal-fade" aria-label="Recommended products to recreate this nail look">
  <div class="shop-the-look__header">
    <div class="shop-the-look__title-wrap">
      <span class="label label-rose">Shop The Look</span>
      <h3 class="shop-the-look__heading">{heading}</h3>
      <p class="shop-the-look__subheading">{subheading}</p>
    </div>
  </div>

  <div class="shop-the-look__grid">
    {products.map((item) => (
      <div class="shop-card hover-lift">
        {item.badge && <span class="shop-card__badge">{item.badge}</span>}
        <div class="shop-card__info">
          <span class="shop-card__category">{item.category}</span>
          <h4 class="shop-card__title">{item.title}</h4>
          {item.description && <p class="shop-card__desc">{item.description}</p>}
        </div>
        <a
          href={item.affiliateUrl}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="shop-card__btn"
          aria-label={`Shop ${item.title} on Amazon (opens in new tab)`}
        >
          Check Price & Details →
        </a>
      </div>
    ))}
  </div>

  <!-- FTC Disclosure -->
  <p class="shop-the-look__disclosure">
    <strong>Affiliate Disclosure:</strong> When you purchase through links on NailSet Gallery, we may earn an affiliate commission at no additional cost to you. We only recommend products we genuinely test and love.
  </p>
</aside>

<style>
  .shop-the-look {
    background-color: var(--color-bg-deep);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin: var(--space-2xl) 0;
  }

  .shop-the-look__header {
    margin-bottom: var(--space-lg);
  }

  .shop-the-look__heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    font-style: italic;
    color: var(--color-text);
    margin-top: var(--space-xs);
  }

  .shop-the-look__subheading {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  .shop-the-look__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .shop-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
  }

  .shop-card__badge {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    background-color: var(--color-blush-light);
    color: var(--color-rose);
    padding: 3px 8px;
    border-radius: var(--radius-full);
  }

  .shop-card__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: var(--space-md);
  }

  .shop-card__category {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-rose);
  }

  .shop-card__title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .shop-card__desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .shop-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px var(--space-md);
    background-color: var(--color-rose);
    color: #ffffff;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
    min-height: 40px;
  }

  .shop-card__btn:hover {
    background-color: var(--color-rose-dark);
    color: #ffffff;
  }

  .shop-the-look__disclosure {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    margin-top: var(--space-lg);
    line-height: 1.4;
    border-top: 1px solid var(--color-border-soft);
    padding-top: var(--space-md);
  }

  @media (max-width: 900px) {
    .shop-the-look__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
